% Original rectangular GPU0 / GPU1 / CPU architecture, with real stage data.
% Thumbnail provenance: overview_assets/system_stages_manifest.json.
\begin{tikzpicture}[x=1cm,y=1cm,
 font=\sffamily\fontsize{8}{9.3}\selectfont,
 >={Stealth[length=4pt,width=3pt]}]
\definecolor{ovblue}{HTML}{376687}
\definecolor{ovteal}{HTML}{167568}
\definecolor{ovamber}{HTML}{AA772C}
\definecolor{ovink}{HTML}{20282C}
\tikzset{
 box/.style={draw=#1,fill=white,line width=.8pt,inner sep=0pt,
   minimum width=4.8cm,minimum height=2.0cm},
 title/.style={font=\sffamily\bfseries\fontsize{8.2}{9.4}\selectfont},
 detail/.style={font=\sffamily\fontsize{6.8}{8}\selectfont,align=center},
 flow/.style={->,draw=ovink,line width=.85pt},
 mapflow/.style={->,draw=ovteal,line width=.9pt},
 poseflow/.style={->,draw=ovblue,dashed,line width=.85pt},
 lab/.style={font=\sffamily\fontsize{6.8}{8}\selectfont,align=center,
    fill=white,inner sep=1.5pt},
 thumb/.style={inner sep=0pt,draw=ovink!30,line width=.35pt}
}
% Restore the original rectangular process and memory boundaries.
\path[draw=ovblue,fill=ovblue!3,line width=1pt] (0,4.85) rectangle (18,13.45);
\path[draw=ovteal,fill=ovteal!3,line width=1pt] (0,0.4) rectangle (10,4.25);
\path[draw=ovamber,fill=ovamber!3,line width=1pt] (10.55,0.4) rectangle (18,4.25);
\node[title,text=ovblue,anchor=west] at (.3,13.15) {GPU 0: SLAM and visualisation};
\node[title,text=ovteal,anchor=west] at (.3,3.94) {GPU 1: online map refinement};
\node[title,text=ovamber,anchor=west] at (10.85,3.94) {CPU shared memory};

% Large image panels: only a compact header and footer per node.
\node[box=ovblue,minimum width=2.5cm,minimum height=2.25cm] (rgb) at (1.65,11.2) {};
\node[title] at (1.65,12.13) {RGB sequence};
\node[thumb] at (1.65,11.08) {\includegraphics[width=2.25cm]{ral/fig/overview_assets/stage_rgb.png}};

\node[box=ovblue,minimum width=6.5cm,minimum height=2.8cm] (main) at (6.7,11.3) {};
\node[title] at (6.7,12.46) {Main process: tracker / Splatt3R};
\node[thumb] at (5.02,11.23) {\includegraphics[width=2.7cm]{ral/fig/overview_assets/stage_rgb.png}};
\node[thumb] at (8.38,11.23) {\includegraphics[width=2.7cm]{ral/fig/overview_assets/stage_pointmap.png}};
\draw[flow] (6.43,11.23) -- (6.97,11.23);
\node[detail] at (6.7,10.02) {RGB $\rightarrow$ pointmap $\cdot$ tracking / FramePoseLog};

\node[box=ovblue,minimum width=6.5cm,minimum height=2.6cm] (sk) at (6.7,8.25) {};
\node[title] at (6.7,9.33) {SharedKeyframes (CUDA IPC)};
\node[thumb] at (4.57,8.27) {\includegraphics[width=2.0cm]{ral/fig/overview_assets/stage_rgb.png}};
\node[thumb] at (6.7,8.27) {\includegraphics[width=2.0cm]{ral/fig/overview_assets/stage_pointmap.png}};
\node[thumb] at (8.83,8.27) {\includegraphics[width=2.0cm,height=1.5cm,keepaspectratio]{ral/fig/overview_assets/stage_local_gaussians_tight.png}};
\node[detail] at (4.57,7.38) {RGB};
\node[detail] at (6.7,7.38) {pointmap};
\node[detail] at (8.83,7.38) {local Gaussians};
\node[detail] at (6.7,7.09) {camera-frame payloads + current poses $T_{WC}$};

\node[box=ovblue,minimum width=5cm,minimum height=1.45cm] (be) at (6.7,5.8) {};
\node[title] at (6.7,6.3) {Backend process};
\node[thumb] at (6.7,5.65) {\includegraphics[width=4.5cm,height=.9cm]{ral/fig/overview_assets/stage_keyframes_panel.png}};

\node[box=ovblue,minimum width=5.4cm,minimum height=2.7cm] (viz) at (14.65,7.6) {};
\node[title] at (14.65,8.72) {Viz process: GUI / OpenGL};
\node[thumb] at (13.33,7.57) {\includegraphics[width=2.45cm]{ral/fig/overview_assets/before.png}};
\node[thumb] at (15.97,7.57) {\includegraphics[width=2.45cm]{ral/fig/overview_assets/after.png}};
\node[detail] at (13.33,6.5) {current-pose bake};
\node[detail] at (15.97,6.5) {refined snapshot};

\node[box=ovteal,minimum width=7.7cm,minimum height=3.15cm] (ref) at (5.15,2.08) {};
\node[title] at (5.15,3.41) {Refiner: LocalGaussianMap + Adam};
\node[thumb] at (3.1,2.03) {\includegraphics[width=3.25cm]{ral/fig/overview_assets/before.png}};
\node[thumb] at (7.2,2.03) {\includegraphics[width=3.25cm]{ral/fig/overview_assets/after.png}};
\draw[mapflow] (4.8,2.03) -- (5.5,2.03);
\node[detail] at (3.1,.66) {before refinement};
\node[detail] at (7.2,.66) {after refinement};

% CPU stores: image-dominant side-by-side cards.
\node[box=ovamber,minimum width=3.3cm,minimum height=3.05cm] (snap) at (12.4,2.08) {};
\node[title,font=\sffamily\bfseries\fontsize{7}{8}\selectfont] at (12.4,3.36) {RefinedMapSnapshot};
\node[thumb] at (12.4,2.08) {\includegraphics[width=3.0cm]{ral/fig/overview_assets/after.png}};
\node[detail] at (12.4,.77) {double buffer + version};
\node[box=ovamber,minimum width=3.3cm,minimum height=3.05cm] (sup) at (16.05,2.08) {};
\node[title,font=\sffamily\bfseries\fontsize{7}{8}\selectfont] at (16.05,3.36) {SupervisionFrames};
\node[thumb] at (16.05,2.08) {\includegraphics[width=3.0cm]{ral/fig/overview_assets/stage_rgb.png}};
\node[detail] at (16.05,.77) {RGB + relative poses};
\node[box=ovink,minimum width=2.5cm,minimum height=2.0cm] (disk) at (5.15,-1.17) {};
\node[thumb] at (5.15,-1.02) {\includegraphics[width=2.0cm]{ral/fig/overview_assets/after.png}};
\node[detail] at (5.15,-1.93) {\texttt{<seq>\_refined.ply}};

% Restore the numbered original routes; arrows stay in node gutters.
\draw[flow] (rgb.east) -- (rgb.east -| main.west) -- (main.west) node[lab,midway,above] {(1)};
\draw[flow] (main.south) -- (sk.north) node[lab,midway,right] {(2) keyframe append};
\draw[flow] (sk.south) -- (be.north) node[lab,midway,left] {(3) read};
\draw[poseflow] (be.east) -- (10.45,5.8) -- (10.45,8.0) -- ($(sk.east)+(0,-.25)$);
\node[lab] at (10.55,6.7) {(4)(6)\\pose updates};
\draw[flow] ($(sk.east)+(0,.45)$) -- (11.1,8.7) -- (11.1,9.6)
 -- (14.65,9.6) -- (viz.north);
\node[lab] at (13.3,9.84) {(5) read + bake with current poses};
\draw[flow] (main.east) -- (18.4,11.3) -- (18.4,2.08) -- (sup.east);
\node[lab] at (14.4,11.5) {(7) tracked RGB + anchor-relative poses};
\draw[mapflow] (sk.west) -- (.65,8.25) -- (.65,2.08) -- (ref.west);
\node[lab] at (1.75,6.6) {new Gaussians\\+ current poses};
\draw[mapflow] ($(ref.east)+(0,.6)$) -- (10.15,2.68)
 -- (10.15,2.08) -- (snap.west);
\node[lab] at (10.1,3.12) {(8) publish};
\draw[mapflow] (snap.north) -- (12.4,5.9) -- (14.65,5.9) -- (viz.south);
\node[lab] at (14.25,4.62) {(8) versioned snapshot};
\draw[mapflow] (sup.south) -- (16.05,.15) -- (9.55,.15)
 -- (9.55,1.43) -- ($(ref.east)+(0,-.65)$);
\node[lab] at (10,1.38) {(7) sample};
\draw[mapflow] (ref.south) -- (disk.north) node[lab,midway,right] {(9) save};
\end{tikzpicture}
