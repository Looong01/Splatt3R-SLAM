\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Head-only adaptation, per family} (ground truth $|$ released checkpoint $|$ head-only fine-tuned), on held-out non-keyframe views. Rows: ETH3D \texttt  {sofa\_1}, EuRoC \texttt  {V1\_01}, TUM \texttt  {fr1\_rpy}, 7-Scenes \texttt  {office}. The first three are families where the recipe clearly helps; the last is the weak family ($+0.14\%$ to $-4.9\%$ LPIPS), included so the failure mode is visible rather than only tabulated. Because the encoder is bit-frozen, the difference between the second and third panel of each row is attributable to the Gaussian head alone.}}{8}{figure.caption.24}\protected@file@percent }
\newlabel{fig:headonly}{{2}{8}{\textbf {Head-only adaptation, per family} (ground truth $|$ released checkpoint $|$ head-only fine-tuned), on held-out non-keyframe views. Rows: ETH3D \texttt {sofa\_1}, EuRoC \texttt {V1\_01}, TUM \texttt {fr1\_rpy}, 7-Scenes \texttt {office}. The first three are families where the recipe clearly helps; the last is the weak family ($+0.14\%$ to $-4.9\%$ LPIPS), included so the failure mode is visible rather than only tabulated. Because the encoder is bit-frozen, the difference between the second and third panel of each row is attributable to the Gaussian head alone}{figure.caption.24}{}}
\newlabel{fig:headonly@cref}{{[figure][2][]2}{[1][7][]8}{}{}{}}
